{
  "version": 1,
  "minimum_available_mib": 512,
  "web_search": false,
  "models": [
    {
      "id": "brain-tools",
      "runtime": {
        "id": "brain-tools",
        "model": "qwen2.5:1.5b",
        "backend": "openai_local",
        "base_url": "http://127.0.0.1:21011/v1",
        "timeout_seconds": 120,
        "max_output_tokens": 256
      },
      "supports_tools": true,
      "max_input_bytes": 65536
    }
  ],
  "assignments": {
    "brain": "brain-tools",
    "workers": []
  },
  "image_models": [
    {
      "id": "image-local",
      "runtime": {
        "id": "image-local",
        "model": "qwen-image-2.1-turbo-q4",
        "backend": "openai_local",
        "base_url": "http://127.0.0.1:21012/v1",
        "timeout_seconds": 600,
        "max_output_tokens": 256
      }
    }
  ],
  "image": "image-local",
  "image_chat": true
}
