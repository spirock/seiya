{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seiya.invalid/contracts/reader-ipc/v0.1-draft.1/response.schema.json",
  "title": "Seiya experimental reader response",
  "type": "object", "additionalProperties": false,
  "required": ["version", "run_id", "results"],
  "properties": {
    "version": {"const": "0.1-draft.1"},
    "run_id": {"$ref": "#/$defs/id"},
    "results": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "text", "text_truncated", "received_bytes", "decoded_bytes", "header_bytes", "get_count"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "status": {"enum": ["ok", "policy_blocked", "timeout", "limit_exceeded", "http_error", "unsupported_format", "no_useful_text", "transport_error"]},
          "text": {"type": ["string", "null"], "maxLength": 20000},
          "text_truncated": {"type": "boolean"},
          "received_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
          "decoded_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
          "header_bytes": {"type": "integer", "minimum": 0, "maximum": 196608},
          "get_count": {"type": "integer", "minimum": 0, "maximum": 3}
        },
        "allOf": [{
          "if": {"properties": {"status": {"const": "ok"}}, "required": ["status"]},
          "then": {"properties": {"text": {"type": "string", "minLength": 1}, "get_count": {"minimum": 1}}},
          "else": {"properties": {"text": {"type": "null"}, "text_truncated": {"const": false}}}
        }]
      }
    }
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"}}
}
