{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seiya internal source selection",
  "type": "object", "additionalProperties": false,
  "required": ["request", "response", "ids"],
  "properties": {
    "request": {"type": "string", "maxLength": 16384},
    "response": {"type": "string", "maxLength": 131072},
    "ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}}
  }
}
