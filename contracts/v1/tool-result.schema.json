{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Seiya tool result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "call_id", "tool_name", "status", "untrusted"],
  "properties": {
    "contract_version": {"const":"1.0-draft.1"},
    "call_id": {"type":"string","minLength":1,"maxLength":128},
    "tool_name": {"type":"string","minLength":1,"maxLength":128},
    "status": {"enum":["completed","failed","cancelled"]},
    "untrusted": {"const":true},
    "data": {"type":"object"},
    "error": {
      "type":"object","additionalProperties":false,"required":["code","message","retryable"],
      "properties":{"code":{"type":"string","maxLength":128},"message":{"type":"string","maxLength":1024},"retryable":{"type":"boolean"}}
    }
  },
  "oneOf": [
    {"properties":{"status":{"const":"completed"}},"required":["data"],"not":{"required":["error"]}},
    {"properties":{"status":{"enum":["failed","cancelled"]}},"required":["error"],"not":{"required":["data"]}}
  ],
  "$comment": "The host must check the tool-specific data shape and 65536-byte result limit. Completed means the adapter verified the effect, not merely that a model requested it. Never log sensitive data by default."
}
